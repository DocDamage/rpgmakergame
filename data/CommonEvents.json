    "list": [
      {
        "code": 108,
        "indent": 0,
        "parameters": [
          "Snapshot quest counts/status variables"
        ]
      },
      {
        "code": 355,
        "indent": 0,
        "parameters": [
          "const api = ChromaEdge && ChromaEdge.Quests ? ChromaEdge.Quests : null;"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "let active = 0;"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "let completed = 0;"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "if (api && api.ready()) {"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "  for (const id of api.ids()) {"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "    const s = api.status(id);"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "    if (s === 'active') active += 1;"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "    if (s === 'completed') completed += 1;"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "  }"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "}"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "$gameVariables.setValue(10, active);"
        ]
      },
      {
        "code": 655,
        "indent": 0,
        "parameters": [
          "$gameVariables.setValue(11, completed);"
        ]
      },
